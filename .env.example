# Banco local usado pelo backend.
# Para desenvolvimento, suba o PostgreSQL com `npm run db:up`.
POSTGRES_HOST_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agilis?schema=public"

# Segredo usado para assinar e validar os JWTs. Gere um valor unico por ambiente.
JWT_SECRET="replace-with-a-strong-random-secret"

# Tempo de expiracao dos tokens.
JWT_EXPIRES_IN="15m"

# Porta da API NestJS.
PORT=3000

# URL do frontend local para CORS.
FRONTEND_URL="http://localhost:4200"
