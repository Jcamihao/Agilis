generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  BACKLOG
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMMENTED
  TASK_MENTIONED
  TASK_DUE_SOON
  TASK_OVERDUE
  TASK_STATUS_CHANGED
  PROJECT_INVITE
  AUTOMATION_TRIGGERED

  INSIGHT_GENERATED
}

enum AutomationTrigger {
  TASK_CREATED
  TASK_STATUS_CHANGED
  TASK_OVERDUE
  COMMENT_CREATED
  TASK_ASSIGNED
}

enum AutomationActionType {
  CHANGE_STATUS
  ASSIGN_USER
  SEND_NOTIFICATION
  CREATE_TASK
  SEND_EMAIL
}

enum ExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

// V4 Enums

enum InsightType {
  RISK
  BOTTLENECK
  DELAY_PREDICTION
  RECOMMENDATION
  ACHIEVEMENT
}

enum InsightSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Company {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           UserCompany[]
  teams           Team[]
  projects        Project[]
  automations     AutomationRule[]
  insights        Insight[]

  aiConversations AiConversation[]
  taskTemplates   TaskTemplate[]

  @@map("companies")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  avatarUrl          String?
  bio                String?
  phone              String?
  notifPreferences   Json?   @map("notif_preferences")
  cpfCnpj            String?
  cep                String?
  uf                 String?
  address            String?
  addressNumber      String?
  addressComplement  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies          UserCompany[]
  assignedTasks      Task[]            @relation("assignedTasks")
  createdTasks       Task[]            @relation("createdTasks")
  teamMemberships    TeamMember[]
  projectMemberships ProjectMember[]
  activities         Activity[]
  comments           Comment[]
  mentions           Mention[]         @relation("mentionedUser")
  notifications      Notification[]
  attachments          Attachment[]
  aiMessages           AiMessage[]
  taskParticipations   TaskParticipant[] @relation("taskParticipations")
  timeEntries          TimeEntry[]
  approvalRequests     TaskApproval[]   @relation("approvalRequests")
  approvalReviews      TaskApproval[]   @relation("approvalReviews")
  taskTemplates         TaskTemplate[]     @relation("taskTemplateCreator")

  @@map("users")
}

model UserCompany {
  id        String   @id @default(uuid())
  userId    String
  companyId String
  role      UserRole @default(MEMBER)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@map("user_companies")
}

model Team {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#6366f1")
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  projects     Project[]
  projectLinks ProjectTeam[]

  @@map("teams")
}

model ProjectTeam {
  id        String @id @default(uuid())
  projectId String
  teamId    String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([projectId, teamId])
  @@map("project_teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  role      UserRole @default(MEMBER)
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  color        String   @default("#6366f1")
  icon         String   @default("folder")
  companyId    String
  teamId       String?
  isArchived   Boolean  @default(false)
  columnConfig Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  team         Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  tasks        Task[]
  sprints      Sprint[]
  automations  AutomationRule[]
  members      ProjectMember[]
  teams        ProjectTeam[]
  customFields CustomField[]

  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      UserRole @default(MEMBER)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Task {
  id                 String     @id @default(uuid())
  title              String
  description        String?
  status             TaskStatus @default(BACKLOG)
  priority           Priority   @default(MEDIUM)
  position           Float      @default(0)
  startDate          DateTime?
  dueDate            DateTime?
  projectId          String
  assigneeId         String?
  creatorId          String
  sprintId           String?
  parentId           String?
  recurrence         String     @default("NONE")
  recurrenceParentId String?  @map("recurrence_parent_id")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee     User?                 @relation("assignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator      User                  @relation("createdTasks", fields: [creatorId], references: [id])
  sprint       Sprint?               @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  parent       Task?                 @relation("subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks     Task[]                @relation("subtasks")
  activities   Activity[]
  comments     Comment[]
  attachments  Attachment[]
  executions   AutomationExecution[]
  participants TaskParticipant[]
  timeEntries       TimeEntry[]
  customFieldValues CustomFieldValue[]
  approvals         TaskApproval[]     @relation("taskApprovals")

  @@index([parentId])
  @@map("tasks")
}

model TimeEntry {
  id          String    @id @default(uuid())
  taskId      String
  userId      String
  startedAt   DateTime
  endedAt     DateTime?
  durationMin Int?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@map("time_entries")
}

model Sprint {
  id        String       @id @default(uuid())
  name      String
  goal      String?
  startDate DateTime?
  endDate   DateTime?
  status    SprintStatus @default(PLANNED)
  projectId String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, status])
  @@map("sprints")
}

model TaskParticipant {
  id     String @id @default(uuid())
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation("taskParticipations", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@map("task_participants")
}

// ─── V2 Models ───────────────────────────────────────────────────────────────

model Comment {
  id        String   @id @default(uuid())
  content   String
  taskId    String
  authorId  String
  isEdited  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task     Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mentions Mention[]

  @@map("comments")
}

model Mention {
  id          String   @id @default(uuid())
  commentId   String
  mentionedId String
  createdAt   DateTime @default(now())

  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentioned User    @relation("mentionedUser", fields: [mentionedId], references: [id], onDelete: Cascade)

  @@unique([commentId, mentionedId])
  @@map("mentions")
}

model Attachment {
  id           String   @id @default(uuid())
  taskId       String
  uploadedById String
  fileName     String
  fileUrl      String
  fileSize     Int
  mimeType     String
  createdAt    DateTime @default(now())

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  type       NotificationType
  title      String
  content    String
  entityType String
  entityId   String
  isRead     Boolean          @default(false)
  metadata   Json?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

// ─── V3 Models ───────────────────────────────────────────────────────────────

model AutomationRule {
  id          String            @id @default(uuid())
  name        String
  description String?
  companyId   String
  projectId   String?
  trigger     AutomationTrigger
  conditions  Json
  actions     Json
  isActive    Boolean           @default(true)
  runCount    Int               @default(0)
  lastRunAt   DateTime?
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project    Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  executions AutomationExecution[]

  @@index([companyId, isActive])
  @@map("automation_rules")
}

model AutomationExecution {
  id         String          @id @default(uuid())
  ruleId     String
  taskId     String?
  status     ExecutionStatus @default(PENDING)
  result     Json?
  error      String?
  durationMs Int?
  createdAt  DateTime        @default(now())

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  task Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([ruleId, createdAt(sort: Desc)])
  @@map("automation_executions")
}

// ─── V4: IA Operacional ──────────────────────────────────────────────────────

model AiConversation {
  id        String   @id @default(uuid())
  companyId String
  userId    String?
  title     String   @default("Nova conversa")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([companyId, createdAt(sort: Desc)])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String // 'user' | 'assistant' | 'system'
  content        String
  userId         String?
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

// ─── V4: Insights ────────────────────────────────────────────────────────────

model Insight {
  id          String          @id @default(uuid())
  companyId   String
  type        InsightType
  severity    InsightSeverity @default(MEDIUM)
  title       String
  description String
  entityType  String?
  entityId    String?
  metadata    Json?
  isRead      Boolean         @default(false)
  isDismissed Boolean         @default(false)
  expiresAt   DateTime?
  createdAt   DateTime        @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, isDismissed, createdAt(sort: Desc)])
  @@index([companyId, type, severity])
  @@map("insights")
}

// ─── Auxiliares ──────────────────────────────────────────────────────────────

model Activity {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String
  metadata   Json?
  userId     String
  taskId     String?
  createdAt  DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@map("activities")
}

// ─── Custom Fields ─────────────────────────────────────────────────────────────

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  MULTI_SELECT
  CHECKBOX
  URL
  EMAIL
  PHONE
}

model CustomField {
  id         String          @id @default(uuid())
  projectId  String
  name       String
  type       CustomFieldType
  options    String[]
  isRequired Boolean         @default(false)
  position   Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  project Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  values  CustomFieldValue[]

  @@index([projectId, position])
  @@map("custom_fields")
}

model CustomFieldValue {
  id            String   @id @default(uuid())
  customFieldId String
  taskId        String
  value         String?
  updatedAt     DateTime @updatedAt

  customField CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([customFieldId, taskId])
  @@index([taskId])
  @@map("custom_field_values")
}

// ─── Task Approvals ───────────────────────────────────────────────────────────

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model TaskApproval {
  id             String         @id @default(uuid())
  taskId         String
  requestedById  String
  approverId     String?
  status         ApprovalStatus @default(PENDING)
  note           String?
  reviewNote     String?
  targetStatus   TaskStatus?
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  task        Task  @relation("taskApprovals", fields: [taskId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("approvalRequests", fields: [requestedById], references: [id])
  approver    User? @relation("approvalReviews",  fields: [approverId],    references: [id])

  @@index([taskId])
  @@index([approverId, status])
  @@index([requestedById])
  @@map("task_approvals")
}

// ─── Task Templates ───────────────────────────────────────────────────────────

model TaskTemplate {
  id             String   @id @default(uuid())
  companyId      String   @map("company_id")
  name           String
  description    String?
  priority       Priority @default(MEDIUM)
  checklist      Json     @default("[]")
  estimatedHours Int?     @map("estimated_hours")
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt      @map("updated_at")

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User    @relation("taskTemplateCreator", fields: [createdById], references: [id])

  @@index([companyId])
  @@map("task_templates")
}
