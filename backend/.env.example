# Database
DATABASE_URL="postgresql://agilis:agilis123@localhost:5432/agilis_db?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-refresh-secret-key"
JWT_REFRESH_EXPIRES_IN="30d"

# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# CORS
CORS_ORIGIN=http://localhost:4200

# Selah IA (toda a IA do Agilis passa por ele). A chave e especifica do app: peca uma entrada AgilisBack em SELAH_APP_KEYS no Selah.
SELAH_IA_BASE_URL=http://localhost:3010
SELAH_IA_API_KEY=
SELAH_IA_SOURCE_APP=AgilisBack
SELAH_IA_TIMEOUT_MS=30000
